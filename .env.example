PORT=3000
HOST=0.0.0.0
TRUST_PROXY=0

# --- CAPTCHA (Google reCAPTCHA v2 Checkbox) ---
CONTACT_CAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_VERIFY_TIMEOUT_MS=10000

# --- SMTP (email delivery for contact forms) ---
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=no-reply@example.com
CONTACT_SMTP_PASS=your_smtp_password
CONTACT_SMTP_FROM="GEOMETRIA <no-reply@example.com>"
CONTACT_RECEIVER_EMAIL=sales@example.com
CONTACT_SMTP_CONNECTION_TIMEOUT_MS=10000
CONTACT_SMTP_GREETING_TIMEOUT_MS=10000
CONTACT_SMTP_SOCKET_TIMEOUT_MS=15000
CONTACT_SMTP_SEND_TIMEOUT_MS=20000

# --- Contact form protection ---
CONTACT_CSRF_SECRET=your_long_random_secret
CONTACT_CSRF_MAX_AGE_MS=7200000
CONTACT_MIN_SUBMIT_DELAY_MS=2500
CONTACT_MAX_SUBMIT_AGE_MS=7200000
CONTACT_MIN_MESSAGE_LENGTH=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX_REQUESTS=8
