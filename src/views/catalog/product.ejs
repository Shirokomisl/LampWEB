<!DOCTYPE html>
<html lang="ru">
  <head>
    <%- include("../partials/head", { pageTitle }) %>
  </head>
  <body class="catalog-page catalog-product-page">
    <%- include("../partials/header", { headerLogo, activePage: "catalog" }) %>

    <main class="catalog-product-main">
      <section
        class="catalog-product-hero-v2"
        style="--product-hero-image: url('<%= product.heroBackdropImage %>')"
      >
        <div class="catalog-product-hero-v2-overlay"></div>
        <div class="catalog-product-hero-v2-content reveal">
          <p class="catalog-product-breadcrumbs">
            <a href="/">Главная</a>
            <span>/</span>
            <a href="/catalog">Каталог</a>
          </p>
          <h1><%= product.name %></h1>
          <p class="catalog-product-year"><%= product.yearLabel %></p>
        </div>
      </section>

      <nav class="catalog-product-tabs" aria-label="Р Р°Р·РґРµР»С‹ РєР°СЂС‚РѕС‡РєРё С‚РѕРІР°СЂР°">
        <div class="catalog-product-tabs-inner">
          <% tabs.forEach((tabItem, index) => { %>
            <a
              class="<%= index === 0 ? 'is-active' : '' %>"
              href="#<%= tabItem.id %>"
              data-product-tab
            >
              <%= tabItem.label %>
            </a>
          <% }) %>
        </div>
      </nav>

      <section class="catalog-product-detail-wrap">
        <div class="catalog-product-detail-grid">
          <aside class="catalog-product-sticky-visual reveal">
            <img src="<%= product.stickyImage %>" alt="<%= product.name %>" />
          </aside>

          <div class="catalog-product-detail-content">
            <section id="about-product" class="catalog-product-section reveal">
              <h2 class="catalog-product-lead"><%= productAbout.lead %></h2>
              <div class="catalog-product-copy-grid">
                <% productAbout.paragraphs.forEach((paragraphText) => { %>
                  <p><%= paragraphText %></p>
                <% }) %>
              </div>
            </section>

            <section id="product-price" class="catalog-product-section catalog-price-section reveal">
              <div class="catalog-price-configurator">
                <h3><%= productPrice.configuratorTitle %></h3>
                <p><%= productPrice.configuratorDescription %></p>
                <div class="catalog-size-picker" role="group" aria-label="<%= productPrice.sizeLabel %>">
                  <span><%= productPrice.sizeLabel %></span>
                  <div class="catalog-size-picker-options <%= productPrice.sizeOptions.length === 1 ? 'is-single' : '' %>">
                    <% productPrice.sizeOptions.forEach((sizeItem) => { %>
                      <button
                        type="button"
                        class="<%= sizeItem.isActive ? 'is-active' : '' %>"
                        data-size-option
                        data-size-price="<%= sizeItem.price %>"
                        aria-label="<%= sizeItem.label %>: <%= sizeItem.formattedPrice %>"
                      >
                        <%= sizeItem.label %>
                      </button>
                    <% }) %>
                  </div>
                </div>
              </div>

              <div class="catalog-price-card">
                <p class="catalog-price-label"><%= productPrice.previewPriceLabel %></p>
                <p class="catalog-price-value" data-product-price-value data-product-price-raw="<%= productPrice.previewPriceRaw %>">
                  <%= productPrice.previewPriceValue %>
                </p>
                <div class="catalog-price-actions">
                  <button
                    type="button"
                    class="catalog-price-request"
                    data-open-request
                    data-request-type="product-request"
                    data-request-origin="product-request"
                    data-request-title="ЗАЯВКА НА ИЗДЕЛИЕ"
                    data-request-subtitle="Пожалуйста, оставьте заявку по форме, представленной ниже. Мы свяжемся с вами в ближайшее время."
                  >
                    <%= productPrice.requestLabel %>
                  </button>
                  <button
                    type="button"
                    data-open-instruction-picker
                  >
                    <%= productPrice.modelLabel %>
                  </button>
                </div>
              </div>
            </section>
          </div>
        </div>
      </section>

      <section id="product-gallery" class="catalog-gallery-section reveal">
        <% const initialGalleryItem = productGallery[0] || { image: product.image, title: product.name, type: "image", poster: "" }; %>
        <div class="catalog-gallery-slider" data-gallery-slider>
          <div class="catalog-gallery-stage">
            <button type="button" class="catalog-gallery-arrow is-prev" data-gallery-prev aria-label="Предыдущее фото">
              <span>&lsaquo;</span>
            </button>

            <figure class="catalog-gallery-main">
              <img
                data-gallery-main-image
                src="<%= initialGalleryItem.image %>"
                alt="<%= initialGalleryItem.title %>"
                class="<%= initialGalleryItem.type === 'video' ? 'is-hidden' : '' %>"
              />
              <video
                data-gallery-main-video
                playsinline
                muted
                loop
                preload="none"
                poster="<%= initialGalleryItem.poster || '' %>"
                class="<%= initialGalleryItem.type === 'video' ? '' : 'is-hidden' %>"
              >
                <source
                  data-gallery-main-video-source
                  src="<%= initialGalleryItem.type === 'video' ? initialGalleryItem.image : '' %>"
                  type="video/quicktime"
                />
              </video>
            </figure>

            <button type="button" class="catalog-gallery-arrow is-next" data-gallery-next aria-label="Следующее фото">
              <span>&rsaquo;</span>
            </button>
          </div>

          <div class="catalog-gallery-thumbs-wrap">
            <button
              type="button"
              class="catalog-gallery-scroll is-prev"
              data-gallery-scroll-prev
              aria-label="Прокрутить миниатюры влево"
            >
              <span>&lsaquo;</span>
            </button>
            <div class="catalog-gallery-thumbs" data-gallery-thumbs>
              <% productGallery.forEach((galleryItem, index) => { %>
                <button
                  type="button"
                  class="catalog-gallery-thumb <%= index === 0 ? 'is-active' : '' %>"
                  data-gallery-thumb
                  data-gallery-index="<%= index %>"
                  data-gallery-image="<%= galleryItem.image %>"
                  data-gallery-title="<%= galleryItem.title %>"
                  data-gallery-type="<%= galleryItem.type || 'image' %>"
                  data-gallery-poster="<%= galleryItem.poster || '' %>"
                  aria-label="Открыть фото: <%= galleryItem.title %>"
                >
                  <img
                    src="<%= galleryItem.type === 'video' && galleryItem.poster ? galleryItem.poster : galleryItem.image %>"
                    alt="<%= galleryItem.title %>"
                  />
                </button>
              <% }) %>
            </div>
            <button
              type="button"
              class="catalog-gallery-scroll is-next"
              data-gallery-scroll-next
              aria-label="Прокрутить миниатюры вправо"
            >
              <span>&rsaquo;</span>
            </button>
          </div>
        </div>
      </section>

      <section class="catalog-product-contact reveal" id="contact-point" data-product-tabs-clear>
        <div class="catalog-product-contact-grid">
          <div class="catalog-product-contact-content">
            <h2><%= productContact.title %></h2>
            <p class="catalog-product-contact-description"><%= productContact.description %></p>

            <% if (contactFeedback) { %>
              <p class="form-feedback <%= contactFeedback.type === 'success' ? 'is-success' : 'is-error' %>">
                <%= contactFeedback.text %>
              </p>
            <% } %>

            <form class="catalog-product-contact-form" action="<%= contactForm.action %>" method="post" novalidate>
              <input type="hidden" name="_csrf" value="<%= contactForm.csrfToken %>" />
              <input type="hidden" name="sourcePath" value="<%= contactForm.sourcePath %>" />
              <input type="hidden" name="formOrigin" value="<%= contactForm.formOrigin %>" />
              <input type="hidden" name="formStartedAt" value="<%= contactForm.formStartedAt %>" />

              <div class="form-honeypot" aria-hidden="true">
                <label for="catalog-website">Website</label>
                <input id="catalog-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <label>
                <span><%= productContact.nameLabel %></span>
                <input type="text" name="name" required minlength="2" maxlength="80" />
              </label>
              <label>
                <span><%= productContact.phoneLabel %></span>
                <input type="tel" name="phone" required minlength="7" maxlength="30" />
              </label>
              <label class="is-wide">
                <span><%= productContact.messageLabel %></span>
                <textarea name="message" rows="2" required minlength="5" maxlength="2000"></textarea>
              </label>

              <% if (contactForm.captchaEnabled) { %>
                <div class="catalog-contact-captcha is-wide">
                  <div class="g-recaptcha" data-sitekey="<%= contactForm.captchaSiteKey %>"></div>
                </div>
              <% } %>

              <button type="submit"><%= productContact.submitLabel %></button>
              <p><%- productContact.policyText %></p>
            </form>
          </div>

          <div class="catalog-product-contact-image">
            <img src="<%= productContact.image %>" alt="<%= product.name %>" />
          </div>
        </div>
      </section>

      <section id="similar-models" class="catalog-similar-section reveal">
        <div class="catalog-similar-head">
          <h2>Похожие товары</h2>
          <a href="/catalog">Смотреть все изделия</a>
        </div>

        <% if (similarProducts.length === 0) { %>
          <p class="catalog-empty-state">Нет изделий для выбранного типа</p>
        <% } else { %>
          <div class="catalog-similar-grid">
            <% similarProducts.forEach((item) => { %>
              <a href="<%= item.href %>">
                <div class="catalog-similar-image">
                  <img src="<%= item.image %>" alt="<%= item.name %>" />
                </div>
                <h3><%= item.name %></h3>
                <p><%= item.description %></p>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>

    <div class="product-request-overlay" data-request-overlay></div>
    <aside class="product-request-drawer" data-request-drawer aria-hidden="true">
      <div class="product-request-header">
        <h2 data-request-title>ЗАЯВКА НА ИЗДЕЛИЕ</h2>
        <button type="button" class="product-request-close" data-request-close aria-label="Закрыть">
          &times;
        </button>
      </div>
      <p class="product-request-subtitle" data-request-subtitle>
        Пожалуйста, оставьте заявку по форме, представленной ниже.
        Мы свяжемся с вами в ближайшее время.
      </p>

      <% if (contactFeedback) { %>
        <p class="form-feedback <%= contactFeedback.type === 'success' ? 'is-success' : 'is-error' %>">
          <%= contactFeedback.text %>
        </p>
      <% } %>

      <form class="product-request-form" action="<%= contactForm.action %>" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= contactForm.csrfToken %>" />
        <input type="hidden" name="sourcePath" value="<%= contactForm.sourcePath %>" />
        <input type="hidden" name="formOrigin" value="<%= contactForm.formOrigin %>" data-request-origin-input />
        <input type="hidden" name="formStartedAt" value="<%= contactForm.formStartedAt %>" />
        <input type="hidden" name="requestType" value="product-request" data-request-type-input />
        <input type="hidden" name="productName" value="<%= product.name %>" />
        <input type="hidden" name="productSize" value="" data-product-size-input />

        <div class="form-honeypot" aria-hidden="true">
          <label for="drawer-website">Website</label>
          <input id="drawer-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="product-request-row">
          <label for="drawer-name">Имя *</label>
          <input id="drawer-name" name="name" type="text" required minlength="2" maxlength="80" />
        </div>
        <div class="product-request-row">
          <label for="drawer-phone">Телефон *</label>
          <input id="drawer-phone" name="phone" type="tel" required minlength="7" maxlength="30" />
        </div>
        <div class="product-request-row product-request-row-wide">
          <label for="drawer-message">Опишите свой вопрос *</label>
          <textarea id="drawer-message" name="message" rows="3" required minlength="5" maxlength="2000"></textarea>
        </div>

        <% if (contactForm.captchaEnabled) { %>
          <div class="product-request-row product-request-row-wide">
            <div class="contact-captcha">
              <div class="g-recaptcha" data-sitekey="<%= contactForm.captchaSiteKey %>"></div>
            </div>
          </div>
        <% } %>

        <button type="submit" class="product-request-submit">ОТПРАВИТЬ</button>
        <p class="product-request-policy"><%- productContact.policyText %></p>
      </form>
    </aside>

    <%- include("../partials/footer", { footerBrandName, footerNote: typeof footerNote !== "undefined" ? footerNote : undefined }) %>

    <div class="instruction-picker-overlay" data-instruction-overlay></div>
    <aside class="instruction-picker-drawer" data-instruction-drawer aria-hidden="true">
      <div class="instruction-picker-header">
        <h2>ИНСТРУКЦИЯ ПО МОНТАЖУ И ЭКСПЛУАТАЦИИ</h2>
        <button type="button" class="instruction-picker-close" data-instruction-close aria-label="Закрыть">
          &times;
        </button>
      </div>
      <p class="instruction-picker-subtitle">
        Выберите тип светильника для просмотра инструкции:
      </p>
      <div class="instruction-picker-buttons">
        <button type="button" class="instruction-picker-option" data-instruction-pdf="/files/info-wall.pdf">
          НАСТЕННЫЕ СВЕТИЛЬНИКИ
        </button>
        <button type="button" class="instruction-picker-option" data-instruction-pdf="/files/info-hanging.pdf">
          ПОДВЕСНЫЕ СВЕТИЛЬНИКИ
        </button>
      </div>
    </aside>
  </body>
</html>
