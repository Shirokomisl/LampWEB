<!DOCTYPE html>
<html lang="ru">
  <head>
    <%- include("../partials/head", { pageTitle }) %>
  </head>
  <body class="contacts-page">
    <%- include("../partials/header", { headerLogo, activePage: "contacts" }) %>

    <main class="contacts-main">
      <section class="contacts-hero">
        <video
          class="contacts-hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster="<%= hero.poster %>"
        >
          <source src="<%= hero.videoSrc %>" type="<%= hero.videoType %>" />
          <source src="<%= hero.videoSrc %>" />
        </video>
        <div class="contacts-hero-shade"></div>
        <div class="contacts-hero-content reveal">
          <p class="contacts-hero-brand"><%= hero.brandLine %></p>
          <h1><%= hero.title %></h1>
        </div>
      </section>

      <section class="contacts-details section-pad" id="contact-point">
        <div class="contacts-details-grid">
          <aside class="contacts-info-card reveal">
            <a class="contacts-phone" href="tel:<%= contactInfo.phoneLink %>">
              <%= contactInfo.phoneDisplay %>
            </a>
            <p class="contacts-email"><%= contactInfo.email %></p>
            <div class="contacts-addresses">
              <% contactInfo.addressLines.forEach((line) => { %>
                <p><%= line %></p>
              <% }) %>
            </div>
            <div class="contacts-socials">
              <% contactInfo.socials.forEach((social) => { %>
                <a href="<%= social.href %>" aria-label="<%= social.name %>">
                  <span><%= social.short %></span>
                </a>
              <% }) %>
            </div>
            <div class="contacts-legal">
              <% (contactInfo.legalLines || []).forEach((line) => { %>
                <p><%= line %></p>
              <% }) %>
            </div>
          </aside>

          <div class="contacts-office-media reveal">
            <img src="<%= contactInfo.officeImage %>" alt="Офис и шоурум" />
          </div>

          <div class="contacts-form-card reveal">
            <h2><%= formBlock.title %></h2>
            <p class="contacts-form-intro"><%= formBlock.subtitle %></p>

            <% if (contactFeedback) { %>
              <p class="form-feedback <%= contactFeedback.type === 'success' ? 'is-success' : 'is-error' %>">
                <%= contactFeedback.text %>
              </p>
            <% } %>

            <form class="contacts-form" action="<%= contactForm.action %>" method="post" novalidate>
              <input type="hidden" name="_csrf" value="<%= contactForm.csrfToken %>" />
              <input type="hidden" name="sourcePath" value="<%= contactForm.sourcePath %>" />
              <input type="hidden" name="formOrigin" value="<%= contactForm.formOrigin %>" />
              <input type="hidden" name="formStartedAt" value="<%= contactForm.formStartedAt %>" />

              <div class="form-honeypot" aria-hidden="true">
                <label for="contacts-website">Website</label>
                <input id="contacts-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="contacts-form-row">
                <label for="contact-name">Имя *</label>
                <input id="contact-name" name="name" type="text" required minlength="2" maxlength="80" />
              </div>
              <div class="contacts-form-row">
                <label for="contact-phone">Телефон *</label>
                <input id="contact-phone" name="phone" type="tel" required minlength="7" maxlength="30" />
              </div>
              <div class="contacts-form-row contacts-form-row-wide">
                <label for="contact-message">Опишите свой вопрос *</label>
                <textarea id="contact-message" name="message" rows="3" required minlength="5" maxlength="2000"></textarea>
              </div>

              <% if (contactForm.captchaEnabled) { %>
                <div class="contacts-form-row contacts-form-row-wide">
                  <div class="contact-captcha">
                    <div class="cf-turnstile" data-sitekey="<%= contactForm.captchaSiteKey %>"></div>
                  </div>
                </div>
              <% } %>

              <button type="submit"><%= formBlock.submitLabel %></button>
            </form>

            <p class="contacts-form-policy"><%= formBlock.policyText %></p>
          </div>
        </div>
      </section>

      <section class="contacts-map">
        <div class="contacts-map-surface">
          <img src="<%= mapBlock.mapImage %>" alt="Карта локации шоурума" />
          <article class="contacts-map-pin reveal">
            <img src="<%= mapBlock.pinImage %>" alt="Локация шоурума" />
            <p><%= mapBlock.addressLabel %></p>
          </article>
          <a href="<%= mapBlock.mapLink %>" target="_blank" rel="noopener noreferrer">
            <%= mapBlock.mapLinkLabel %>
          </a>
        </div>
      </section>
    </main>

    <%- include("../partials/footer", { footerBrandName, footerNote: typeof footerNote !== "undefined" ? footerNote : undefined }) %>
  </body>
</html>
