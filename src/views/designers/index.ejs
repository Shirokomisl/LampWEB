<!DOCTYPE html>
<html lang="ru">
  <head>
    <%- include("../partials/head", { pageTitle }) %>
  </head>
  <body class="designers-page">
    <%- include("../partials/header", { headerLogo, activePage: "designers" }) %>

    <main class="designers-main">
      <section class="designers-hero">
        <div class="designers-grid">
          <article class="designers-panel designers-panel--text reveal">
            <div class="designers-text">
              <p><%= hero.description[0] %></p>
            </div>
          </article>

          <figure class="designers-panel designers-panel--media reveal">
            <img src="<%= gridImages[0].src %>" alt="<%= gridImages[0].alt %>" loading="lazy" />
          </figure>

          <article class="designers-panel designers-panel--text reveal">
            <div class="designers-text">
              <p><%= hero.description[1] %></p>
            </div>
          </article>

          <figure class="designers-panel designers-panel--media reveal">
            <img src="<%= gridImages[1].src %>" alt="<%= gridImages[1].alt %>" loading="lazy" />
          </figure>

          <article class="designers-panel designers-panel--text reveal">
            <div class="designers-text">
              <p><%= hero.highlight %></p>
            </div>
          </article>

          <figure class="designers-panel designers-panel--media reveal">
            <img src="<%= gridImages[2].src %>" alt="<%= gridImages[2].alt %>" loading="lazy" />
          </figure>
        </div>

        <div class="designers-actions">
          <button
            type="button"
            class="designers-action is-primary"
            data-open-request
            data-request-type="<%= actions.request3dType %>"
            data-request-origin="<%= actions.request3dOrigin %>"
            data-request-title="<%= actions.request3dTitle %>"
            data-request-subtitle="<%= actions.request3dSubtitle %>"
          >
            <%= actions.request3dLabel %>
          </button>
          <a
            class="designers-action is-outline"
            href="<%= actions.catalogPdfHref %>"
            target="_blank"
            rel="noopener"
          >
            <%= actions.catalogPdfLabel %>
          </a>
        </div>
      </section>

      <div id="contact-point"></div>
    </main>

    <div class="product-request-overlay" data-request-overlay></div>
    <aside class="product-request-drawer" data-request-drawer aria-hidden="true">
      <div class="product-request-header">
        <h2 data-request-title><%= requestDrawer.title %></h2>
        <button type="button" class="product-request-close" data-request-close aria-label="Закрыть">
          &times;
        </button>
      </div>
      <p class="product-request-subtitle" data-request-subtitle>
        <%= requestDrawer.subtitle %>
      </p>

      <% if (contactFeedback) { %>
        <p class="form-feedback <%= contactFeedback.type === 'success' ? 'is-success' : 'is-error' %>">
          <%= contactFeedback.text %>
        </p>
      <% } %>

      <form class="product-request-form" action="<%= contactForm.action %>" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= contactForm.csrfToken %>" />
        <input type="hidden" name="sourcePath" value="<%= contactForm.sourcePath %>" />
        <input type="hidden" name="formOrigin" value="<%= contactForm.formOrigin %>" data-request-origin-input />
        <input type="hidden" name="formStartedAt" value="<%= contactForm.formStartedAt %>" />
        <input type="hidden" name="requestType" value="<%= actions.request3dType %>" data-request-type-input />
        <input type="hidden" name="productName" value="" />
        <input type="hidden" name="productSize" value="" data-product-size-input />

        <div class="form-honeypot" aria-hidden="true">
          <label for="designers-website">Website</label>
          <input id="designers-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="product-request-row">
          <label for="designers-name">Имя *</label>
          <input id="designers-name" name="name" type="text" required minlength="2" maxlength="80" />
        </div>
        <div class="product-request-row">
          <label for="designers-phone">Телефон *</label>
          <input id="designers-phone" name="phone" type="tel" required minlength="7" maxlength="30" />
        </div>
        <div class="product-request-row product-request-row-wide">
          <label for="designers-message">Опишите свой вопрос *</label>
          <textarea id="designers-message" name="message" rows="3" required minlength="5" maxlength="2000"></textarea>
        </div>

        <% if (contactForm.captchaEnabled) { %>
          <div class="product-request-row product-request-row-wide">
            <div class="contact-captcha">
              <div class="g-recaptcha" data-sitekey="<%= contactForm.captchaSiteKey %>"></div>
            </div>
          </div>
        <% } %>

        <button type="submit" class="product-request-submit"><%= requestDrawer.submitLabel %></button>
        <p class="product-request-policy"><%- requestDrawer.policyText %></p>
      </form>
    </aside>

    <%- include("../partials/footer", { footerBrandName, footerNote: typeof footerNote !== "undefined" ? footerNote : undefined }) %>
  </body>
</html>
